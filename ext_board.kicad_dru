(version 1)
(rule "60664 Outer DGND/PUPGND"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('PUPGND')")
)
(rule "60664 Outer  Earth/PUPGND"
	(layer outer)
	(constraint creepage (min 4mm))
	(condition "A.hasNetclass('Earth') && B.hasNetclass('PUPGND')")
)
(rule "60664 PDOWNGND/Earth"
	(layer outer)
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('PDOWNGND') && B.hasNetclass('Earth')")
)
(rule "IPC2221 A6 Pads PUPGND/PDOWNGND"
	(layer outer)
	(constraint clearance (min 2.415mm))
	(condition "A.hasNetclass('PUPGND') && A.Type == 'Pad' && B.hasNetclass('PDOWNGND') && B.Type == 'Pad'")
)
(rule "IPC2221 B4 Tracks  PUPGND/PDOWNGND"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('PUPGND') && B.hasNetclass('PDOWNGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B1 Tracks PUPGND/PDOWNGND"
	(layer inner)
	(constraint clearance (min 1mm))
	(condition "A.hasNetclass('PUPGND') && B.hasNetclass('PDOWNGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B1 Tracks VUP/PDOWNGND"
	(layer inner)
	(constraint clearance (min 1mm))
	(condition "A.hasNetclass('VUP') && B.hasNetclass('PDOWNGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B1 Tracks VUP/PUPGND"
	(layer inner)
	(constraint clearance (min 1mm))
	(condition "A.hasNetclass('VUP') && B.hasNetclass('PUPGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "60664 DGND/PDOWNGND"
	(layer outer)
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('PDOWNGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks VUP/PDOWNGND"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('VUP') && B.hasNetclass('PDOWNGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B4 Tracks VDOWN/PDOWNGND"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('VDOWN') && B.hasNetclass('PDOWNGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B4 Tracks VUP/PUPGND"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('VUP') && B.hasNetclass('PUPGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B4 Tracks VDOWN/PUPGND"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('VDOWN') && B.hasNetclass('PUPGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B1 Tracks VUP/VDOWN"
	(layer inner)
	(constraint clearance (min 1mm))
	(condition "A.hasNetclass('VUP') && B.hasNetclass('VDOWN') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 B1 Tracks VDOWN/PDOWNGND"
	(layer inner)
	(constraint clearance (min 1mm))
	(condition "A.hasNetclass('VDOWN') && B.hasNetclass('PDOWNGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "60664 VUP/Earth"
